{
  "name": "ielts-mock",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:remote": "API_URL=https://ielts-development-9acd2.ondigitalocean.app/api turbo run dev --filter=@ielts-mock/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "turbo run start",
    "db:generate": "pnpm --filter @ielts-mock/db db:generate",
    "db:migrate": "pnpm --filter @ielts-mock/db db:migrate",
    "db:seed": "pnpm --filter @ielts-mock/db db:seed",
    "db:studio": "pnpm --filter @ielts-mock/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
