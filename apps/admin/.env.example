# Environment: local (your laptop). See docs/environments.md.
# Copy to .env.local and fill in.
APP_ENV=local
API_URL=http://localhost:4000
# Same value as ADMIN_API_KEY in apps/api/.env (openssl rand -hex 32).
ADMIN_API_KEY=
# Password gate (apps/admin/proxy.ts) is only used outside local; leave unset here.
# ADMIN_BASIC_AUTH_USER=
# ADMIN_BASIC_AUTH_PASSWORD=

# WorkOS (Staging environment for local and development). Dashboard → API Keys.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Encrypts the session cookie, min. 32 characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/admin/callback
