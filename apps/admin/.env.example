# Environment: local (your laptop). See docs/environments.md.
# Copy to .env.local and fill in.
APP_ENV=local
API_URL=http://localhost:4000

# WorkOS (Staging environment for local and development). Dashboard → API Keys.
# Client ID only: the admin never needs the secret API key.
WORKOS_CLIENT_ID=
# Encrypts the session cookie, min. 32 characters: openssl rand -base64 32
# (a different value from apps/web).
WORKOS_COOKIE_PASSWORD=
# Must differ from apps/web's cookie (they share a domain when deployed).
WORKOS_COOKIE_NAME=wos-admin-session
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/admin/callback
