# Environment: local (your laptop). See docs/environments.md.
# Optional: copy to .env.local to override the defaults below.
APP_ENV=local
API_URL=http://localhost:4000

# WorkOS (Staging environment for local and development). Dashboard → API Keys.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Encrypts the session cookie, min. 32 characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
