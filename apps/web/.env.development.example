# Environment: development (deployed from the `development` branch).
# Reference only: these values are set in DigitalOcean, never in a committed
# file. See docs/environments.md.
NODE_ENV=production
APP_ENV=development

# Internal URL of the development API (not public)
API_URL=

# WorkOS Staging environment. Client ID and cookie password are SECRETs in the app
# spec; the redirect URI is also needed at build time (inlined by Next.js).
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://ielts-development-9acd2.ondigitalocean.app/callback
