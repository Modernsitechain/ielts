# Environment: local (your laptop). See docs/environments.md.
# Copy to .env and fill in. Tests use .env.test with the same keys and
# DATABASE_URL pointing at the ielts_mock_test database.
APP_ENV=local
PORT=4000
DATABASE_URL=postgresql://USER@localhost:5432/ielts_mock

# Key apps/admin sends to the /admin endpoints (temporary until WorkOS login).
# Generate your own with: openssl rand -hex 32. Use the same value in
# apps/admin/.env.local. Leave empty to disable the admin endpoints.
ADMIN_API_KEY=
