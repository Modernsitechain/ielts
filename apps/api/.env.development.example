# Environment: development (deployed from the `development` branch).
# Reference only: these values are set in DigitalOcean, never in a committed
# file. Lines marked [secret] must be stored encrypted. See docs/environments.md.
NODE_ENV=production
APP_ENV=development
PORT=4000

# [secret] DigitalOcean Managed PostgreSQL, database ielts_mock_development
DATABASE_URL=

# [secret] CA certificate of the database cluster (PEM or base64)
DATABASE_CA_CERT=

# Temporary admin key, shared with the admin component (SECRET in the app
# spec), until apps/admin signs in with WorkOS.
ADMIN_API_KEY=

# WorkOS Staging environment (SECRET in the app spec).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
